{{:helper.DAISMode()}}
{{if data.error}}
	<h2>An error has occurred:</h2>
	Additional information: {{:data.error}}<br>
	<i>Please try again. If the problem persists, contact your system administrator for assistance.</i>
	{{:helper.link('', 'arrowreturn-1-w', {'PRG_backtomenu': 1})}}
{{else}}
	{{if data.browsing}}
		{{:helper.link('', 'arrowreturn-1-w', {'PRG_closebrowser': 1})}}
		<h2>Local Engrams:</h2>
		<table>
			<tr>
				<th>Name (HGR)
				<th>Size (GQ)
			{{for data.files}}
			<tr>
				<td>{{:helper.link(value.name, null, {'PRG_openfile': value.name})}}
				<td>{{:value.size}}
			{{/for}}
		</table>
		{{if data.usbfiles}}
			<h2>External Engrams (Removable storage):</h2>
			<table>
				<tr>
					<th>Name
					<th>Size (GQ)
				{{for data.usbfiles}}
				<tr>
					<td>{{:helper.link(value.name, null, {'PRG_openfile': value.name})}}
					<td>{{:value.size}}
				{{/for}}
			</table>
		{{/if}}
	{{else}}
		<h2>Document: {{:data.filename}}</h2>
		<div class='item'>
			{{:helper.link('Clear', 'document', {'PRG_clear': 1})}}
			{{:helper.link('Load', 'folder-open', {'PRG_loadmenu': 1})}}
			{{:helper.link('Save', 'disk', {'PRG_save': 1})}}
			{{:helper.link('Set File Name', null, {'PRG_rename': 1})}}
			{{:helper.link(data.default_delay, null, {'PRG_default_delay': 1})}}
		</div>
		{{if data.filedata}}
		<hr>
		<div class='block'>
			<style>
				#HoloAlgorithmEditor {
					width: 100%;
				}
				#HoloAlgorithmEditor .holoeditorCell, #HoloAlgorithmEditor .holoeditorHeaderCell {
					border-right: 1px solid #677;
					border-left: 1px solid #677;
					border-radius: 4px;

					padding: 3px;
					min-width: 5px;
					max-width: 300px;
					overflow: hidden;
					white-space: wrap;
				}
				#HoloAlgorithmEditor th
				{
					border-radius: 3px 3px 0 0;
				}
				#HoloAlgorithmEditor .link
				{
					margin-bottom: 0;
				}
			</style>
			<div style = "width: 100%; text-align: right;">
				{{:data.filedata_size}} GQ
			</div>
			<table id = "HoloAlgorithmEditor">
				<tr>
					<th class='holoeditorHeaderCell' style='max-width: 5px'>#
					<th class='holoeditorHeaderCell' style='min-width: 50px; max-width: 100px'>Message
					<th class='holoeditorHeaderCell' style='max-width: 5px'>Delay
					<!-- <th>Go to -->
					<th class='holoeditorHeaderCell' style='max-width: 5px'>{{:helper.link('', 'plus', {'PRG_addcommand': -1})}}
				{{for data.filedata :value :Index}}
				<tr>
					<td class='holoeditorCell' style='max-width: 5px'>
						<table>
							<tr><td>{{:helper.link('','carat-1-n', {'PRG_swap': Index, 'PRG_swap_index': -1}, Index == 0 ? 'linkOff' : null)}}
							<tr><td>{{:helper.link(Index + 1,null, {'PRG_swap': Index})}}
							<tr><td>{{:helper.link('','carat-1-s', {'PRG_swap': Index, 'PRG_swap_index':1}, ((Object.keys(data.filedata).length == Index + 1) ? 'linkOff' : null))}}
						</table>
					<td class='holoeditorCell' style='min-width: 50px; max-width: 100px'>{{:helper.link('','pencil', {'PRG_change_message': Index})}}:<br>"{{:value.message}}"
					<td class='holoeditorCell' style='max-width: 5px'>{{:helper.link(value.delay, null, {'PRG_change_sleep': Index})}}
					<!-- <td>{{:helper.link(value.goto, null, {'PRG_change_goto': Index})}} -->
					<td class='holoeditorCell' style='max-width: 5px'>
						<table>
							<tr><td>{{:helper.link('','plus', {'PRG_addcommand': Index})}}
							<tr><td>{{:helper.link('','minus', {'PRG_removecommand': Index})}}
						</table>
				{{/for}}
			</table>
		</div>
		{{/if}}
	{{/if}}
{{/if}}
